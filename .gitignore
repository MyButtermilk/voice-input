/app/build/intermediates/merged_native_libs/
/app/build/intermediates/stripped_native_libs/

# Generated resources and classes
/app/build/generated/
/app/build/intermediates/
/app/build/kotlin/
/app/build/tmp/

# Development tools and SDKs (should not be committed)
.tools/
.claude/